{
  "name": "happy-haseyeon",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler pages dev . --persist-to=.wrangler/state",
    "db:init": "wrangler d1 execute happy-haseyeon-db --local --persist-to=.wrangler/state --file=./schema.sql",
    "db:seed": "wrangler d1 execute happy-haseyeon-db --local --persist-to=.wrangler/state --file=./seed.sql",
    "deploy": "wrangler pages deploy . --project-name=happy-haseyeon --commit-dirty=true",
    "db:remote": "wrangler d1 execute happy-haseyeon-db --remote --file=./schema.sql",
    "db:remote:seed": "wrangler d1 execute happy-haseyeon-db --remote --file=./seed.sql"
  },
  "devDependencies": {
    "wrangler": "^4.24.0"
  }
}
